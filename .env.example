# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/itsm

# Used only by pytest. Must point at a SEPARATE database whose name ends in "_test":
# the test suite drops and recreates tables in it.
# Export it in your shell before running pytest (pytest does not read .env).
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/itsm_test

# LLM used to classify tickets. Tests never use these: they run against a mock.
# If they are missing, /process still works but classification fails safely
# (ticket goes to awaiting_human, no result is invented).
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# Embeddings for knowledge search. Any service with an OpenAI-style POST {base_url}/embeddings.
# Tests never use these: they run against a mock embedder.
# EMBEDDING_DIMENSION must equal the model's vector size (1536 for text-embedding-3-small).
# If you change the model, re-run: python -m scripts.index_knowledge
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIMENSION=1536
EMBEDDING_TIMEOUT_SECONDS=30

# Retrieval. RETRIEVAL_MIN_SCORE is the minimum cosine similarity for a chunk to count as
# relevant. 0.30 is an UNVALIDATED starting point: tune it with POST /knowledge/search.
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.30
